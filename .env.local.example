# CT Battery Solutions — web environment variables
# Copy this to .env.local and fill in your values:
#   cp .env.local.example .env.local

# Backend API base URL.
#   - Local dev: point at the backend on :3000
#   - Production: leave blank; Netlify proxies /api/* to the droplet (same-origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Google Maps (Places autocomplete + client-side geocoding)
# Get free at: https://console.cloud.google.com (enable Maps JavaScript + Geocoding API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your key>
